<Application x:Class="MyDict.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
<Application.Resources>
 <Style TargetType="ToolTip"><Setter Property="Visibility" Value="Collapsed"/></Style>
 <SolidColorBrush x:Key="Primary" Color="{DynamicResource color.c5c4bb7}"/>
 <SolidColorBrush x:Key="Ink" Color="{DynamicResource color.c272438}"/>
 <SolidColorBrush x:Key="Muted" Color="{DynamicResource color.c777387}"/>
 <Style TargetType="Button">
  <Setter Property="Padding" Value="{DynamicResource thickness.app.setter.7.padding}"/><Setter Property="Margin" Value="{DynamicResource thickness.app.setter.8.margin}"/><Setter Property="Background" Value="{DynamicResource brush.ceeeaf8}"/><Setter Property="Foreground" Value="{DynamicResource brush.c514297}"/><Setter Property="FontWeight" Value="{DynamicResource weight.app.setter.11.fontweight}"/><Setter Property="BorderThickness" Value="{DynamicResource thickness.app.setter.12.borderthickness}"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource corner.app.surface.cornerradius}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{DynamicResource halign.app.contentpresenter.18.horizontalalignment}" VerticalAlignment="{DynamicResource valign.app.contentpresenter.18.verticalalignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="{DynamicResource number.app.setter.21.opacity}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="{DynamicResource number.app.setter.23.opacity}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource brush.c9686da}"/><Setter TargetName="Surface" Property="BorderThickness" Value="{DynamicResource thickness.app.setter.26.borderthickness}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource number.app.setter.28.opacity}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="TextBox">
  <Setter Property="Padding" Value="{DynamicResource thickness.app.setter.30.padding}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="{DynamicResource brush.cf7f5fb}"/><Setter Property="BorderBrush" Value="{DynamicResource brush.ce4dfee}"/><Setter Property="BorderThickness" Value="{DynamicResource thickness.app.setter.34.borderthickness}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Frame" CornerRadius="{DynamicResource corner.app.frame.cornerradius}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource brush.c7866c8}"/><Setter TargetName="Frame" Property="BorderThickness" Value="{DynamicResource thickness.app.setter.44.borderthickness}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource brush.cf0edf7}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="{DynamicResource thickness.app.setter.49.padding}"/><Setter Property="Margin" Value="{DynamicResource thickness.book.row_margin}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Item" Background="{DynamicResource brush.transparent}" CornerRadius="{DynamicResource corner.app.item.cornerradius}" Padding="{DynamicResource thickness.book.row_padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource brush.cf6f3fc}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource brush.cede7fa}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="{DynamicResource brush.ca193cf}"/><Setter TargetName="Item" Property="BorderThickness" Value="{DynamicResource thickness.app.setter.63.borderthickness}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource brush.white}"/><Setter Property="CornerRadius" Value="{DynamicResource corner.app.setter.66.cornerradius}"/><Setter Property="BorderBrush" Value="{DynamicResource brush.ceeeaf4}"/><Setter Property="BorderThickness" Value="{DynamicResource thickness.app.setter.68.borderthickness}"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="{DynamicResource color.c34255c}" BlurRadius="{DynamicResource number.app.dropshadoweffect.71.blurradius}" ShadowDepth="{DynamicResource number.app.dropshadoweffect.71.shadowdepth}" Opacity="{DynamicResource number.app.dropshadoweffect.71.opacity}"/></Setter.Value></Setter></Style>
</Application.Resources>
</Application>




