<Window x:Class="MyDict.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/MyDict;component/assets/app-icon.ico" Title="设置" Width="{DynamicResource number.settingswindow.window.1.width}" Height="{DynamicResource number.settingswindow.window.1.height}" MinWidth="{DynamicResource number.settingswindow.window.1.minwidth}" MinHeight="{DynamicResource number.settingswindow.window.1.minheight}" WindowStartupLocation="CenterOwner" Background="{DynamicResource brush.cf5f3fa}" FontFamily="{DynamicResource font.settingswindow.window.1.fontfamily}" FontSize="{DynamicResource number.settingswindow.window.1.fontsize}" ShowInTaskbar="False" UseLayoutRounding="True" TextOptions.TextFormattingMode="{DynamicResource formatting.settingswindow.window.1.textoptions.textformattingmode}" TextOptions.TextRenderingMode="{DynamicResource rendering.settingswindow.window.1.textoptions.textrenderingmode}" TextOptions.TextHintingMode="{DynamicResource hinting.settingswindow.window.1.textoptions.texthintingmode}">
<Grid Margin="{DynamicResource thickness.settingswindow.grid.2.margin}"><Grid.RowDefinitions><RowDefinition Height="{DynamicResource grid.settingswindow.rowdefinition.4.height}"/><RowDefinition Height="{DynamicResource grid.settingswindow.rowdefinition.5.height}"/><RowDefinition Height="{DynamicResource grid.settingswindow.rowdefinition.6.height}"/></Grid.RowDefinitions>
<TextBlock Text="设置" FontSize="{DynamicResource number.settingswindow.textblock.7.fontsize}" FontWeight="{DynamicResource weight.settingswindow.textblock.7.fontweight}" Margin="{DynamicResource thickness.settingswindow.textblock.7.margin}"/>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="{DynamicResource thickness.settingswindow.stackpanel.9.margin}">
<TextBlock Text="显示" Foreground="{DynamicResource brush.c65558f}" FontWeight="{DynamicResource weight.settingswindow.textblock.10.fontweight}" Margin="{DynamicResource thickness.settingswindow.textblock.10.margin}"/>
<TextBlock Text="系统字体"/><ComboBox x:Name="FontPicker" Margin="{DynamicResource thickness.settingswindow.fontpicker.margin}" Height="{DynamicResource number.settingswindow.fontpicker.height}" IsEditable="False"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="{DynamicResource thickness.settingswindow.stackpanel.17.margin}"><TextBlock Text="正文字号（12–28）"/><TextBox x:Name="SizeInput" Margin="{DynamicResource thickness.settingswindow.sizeinput.margin}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="查询延迟（毫秒）"/><TextBox x:Name="DelayInput" Margin="{DynamicResource thickness.settingswindow.delayinput.margin}"/></StackPanel></Grid>
<Border Background="{DynamicResource brush.white}" CornerRadius="{DynamicResource corner.settingswindow.border.23.cornerradius}" Padding="{DynamicResource thickness.settingswindow.border.23.padding}" Margin="{DynamicResource thickness.settingswindow.border.23.margin}"><TextBlock x:Name="FontPreview" Text="拾词 Dictionary /ˈwɜːd/" TextWrapping="Wrap"/></Border>
<CheckBox x:Name="ExamplesCheck" Content="显示例句" Margin="{DynamicResource thickness.settingswindow.examplescheck.margin}"/><CheckBox x:Name="DerivedCheck" Content="显示派生词与搭配" Margin="{DynamicResource thickness.settingswindow.derivedcheck.margin}"/>
<TextBlock Text="在线翻译" Foreground="{DynamicResource brush.c65558f}" FontWeight="{DynamicResource weight.settingswindow.textblock.27.fontweight}"/><ComboBox x:Name="ProviderPicker" Margin="{DynamicResource thickness.settingswindow.providerpicker.margin}" Height="{DynamicResource number.settingswindow.providerpicker.height}"><ComboBoxItem Content="MyMemory（默认，无需密钥）"/><ComboBoxItem Content="LibreTranslate（需配置服务）"/></ComboBox>
<StackPanel x:Name="LibrePanel"><TextBlock Text="LibreTranslate 服务完整地址"/><TextBox x:Name="UrlInput" Margin="{DynamicResource thickness.settingswindow.urlinput.margin}"/><TextBlock Text="API Key（按服务要求填写）"/><PasswordBox x:Name="KeyInput" Padding="{DynamicResource thickness.settingswindow.keyinput.padding}" Margin="{DynamicResource thickness.settingswindow.keyinput.margin}"/><TextBlock Text="公共服务通常需要密钥；也可使用本机服务。密钥使用 Windows 当前用户加密保存。" Foreground="{DynamicResource brush.c847a91}" FontSize="{DynamicResource number.settingswindow.textblock.36.fontsize}" TextWrapping="Wrap" Margin="{DynamicResource thickness.settingswindow.textblock.36.margin}"/></StackPanel>
<TextBlock Text="详细英文词典：Free Dictionary API；派生词：Wiktionary。更换翻译来源不影响这两项资料。" FontSize="{DynamicResource number.settingswindow.textblock.37.fontsize}" Foreground="{DynamicResource brush.c847a91}" TextWrapping="Wrap"/>
<TextBlock x:Name="ErrorText" Foreground="{DynamicResource brush.cad3c51}" TextWrapping="Wrap" Margin="{DynamicResource thickness.settingswindow.errortext.margin}"/>
</StackPanel></ScrollViewer>
<DockPanel Grid.Row="2" Margin="{DynamicResource thickness.settingswindow.dockpanel.39.margin}"><Button Content="恢复默认" Background="{DynamicResource brush.transparent}" Click="Defaults_Click" DockPanel.Dock="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource halign.settingswindow.stackpanel.41.horizontalalignment}"><Button Content="取消" IsCancel="True" Background="{DynamicResource brush.transparent}"/><Button Content="保存" Background="{DynamicResource brush.c5c4bb7}" Foreground="{DynamicResource brush.white}" IsDefault="True" Click="Save_Click"/></StackPanel></DockPanel>
</Grid></Window>

